# Copia este ficheiro para ".env" e preenche com os teus valores reais.
# ".env" nunca deve ser commitado (ja esta no .gitignore).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email da tua conta em portugalf1gp.com (login e so por codigo enviado
# a este email -- nao ha password). Ver LOGIN_FLOW.md.
SITE_EMAIL=

# Canal do browser usado pelo purchase_agent (Playwright). "chrome" usa o
# Google Chrome instalado no sistema -- necessario nalgumas maquinas onde
# os binarios proprios do Playwright nao correm. Usa "chromium" se os
# binarios do Playwright funcionarem na tua maquina.
BROWSER_CHANNEL=chrome
